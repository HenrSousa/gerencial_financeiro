{
  "routes": [
    { "route": "/login.html", "allowedRoles": ["anonymous", "authenticated"], "headers": { "Cache-Control": "no-cache" } },
    { "route": "/.auth/login/github", "statusCode": 404 },
    { "route": "/.auth/login/twitter", "statusCode": 404 },
    { "route": "/*", "allowedRoles": ["leitor"], "headers": { "Cache-Control": "no-cache" } }
  ],
  "responseOverrides": {
    "401": { "redirect": "/login.html", "statusCode": 302 },
    "403": { "redirect": "/login.html", "statusCode": 302 }
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "same-origin"
  }
}
